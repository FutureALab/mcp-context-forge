server {
    listen 18080;
    server_name ${DEMO_HOST};
    access_log off;
    root /usr/share/nginx/html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin always;
    location /portal/ {
        proxy_pass http://identity:8080;
        proxy_set_header Host $http_host;
    }
    location /oidc/ {
        proxy_pass http://identity:8080;
        proxy_set_header Host $http_host;
    }
    location / {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' http://${DEMO_HOST}:18081; frame-src 'self' http://${DEMO_HOST}:18081; frame-ancestors 'none'" always;
        try_files $uri $uri/ =404;
    }
}

server {
    listen 18081;
    server_name ${DEMO_HOST};
    access_log off;
    location = /embed/session {
        limit_except GET { deny all; }
        proxy_pass http://${GATEWAY_UPSTREAM}/auth/email/me;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "Bearer $cookie_jwt_token";
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control no-store always;
    }
    location /embed/ {
        alias /usr/share/nginx/html/embed/;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors http://${DEMO_HOST}:18080" always;
        add_header Referrer-Policy no-referrer always;
    }
    location / {
        proxy_pass http://${GATEWAY_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Authenticated-User "";
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        add_header Content-Security-Policy "frame-ancestors http://${DEMO_HOST}:18080" always;
    }
}
